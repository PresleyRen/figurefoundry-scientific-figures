        "Context",
        "Proposed"
      ],
      "xlabel": "Training epoch",
      "ylabel": "Task success (%)",
      "title": "Learning dynamics",
      "legend_loc": "lower right"
    },
    {
      "kind": "box",
      "data": "data/endpoints.csv",
      "x": "method",
      "y": "success",
      "order": [
        "Baseline",
        "Context",
        "Proposed"
      ],
      "xlabel": "Method",
      "ylabel": "Task success (%)",
      "title": "Independent run variation"
    },
    {
      "kind": "heatmap",
      "data": "data/tasks.csv",
      "x": "task",
      "y": "method",
