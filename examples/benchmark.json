      "x_order": [
        "Reasoning",
        "Retrieval",
        "Planning",
        "Tools"
      ],
      "y_order": [
        "Baseline",
        "Context",
        "Proposed"
      ],
      "xlabel": "Task family",
      "title": "Performance by task",
      "number_format": ".0f",
      "colorbar_label": "Success (%)",
      "vmin": 45,
      "vmax": 85,
      "x_tick_rotation": 20
    },
    {
      "kind": "pareto",
      "data": "data/pareto.csv",
      "x": "cost",
      "y": "success",
      "label": "method",
      "xlabel": "Relative inference cost",
      "ylabel": "Task success (%)",
      "title": "Quality–cost trade-off",
      "legend_loc": "lower right"
